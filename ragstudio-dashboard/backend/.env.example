# RAG AI Platform - Backend Configuration
# Copy this file to .env and modify values as needed

# Application
APP_NAME=RAG AI Platform
APP_VERSION=1.0.0
DEBUG=true
ENVIRONMENT=development

# API
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
API_PREFIX=/api/v1

# CORS
CORS_ORIGINS=["http://localhost:5176","http://localhost:3000","http://localhost:5173"]

# Database (Postgres via Docker or SQLite fallback)
DATABASE_URL=sqlite+aiosqlite:///./ragstudio.db
# For Docker: DATABASE_URL=postgresql+asyncpg://ragstudio:ragstudio@postgres:5432/ragstudio
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]

# Security (CHANGE IN PRODUCTION!)
SECRET_KEY=your-super-secret-key-change-this-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=llama3:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_TIMEOUT=120
OLLAMA_MAX_RETRIES=3

# ChromaDB Configuration
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_COLLECTION_NAME=rag_documents
CHROMA_DISTANCE_METRIC=cosine
CHROMA_HNSW_SPACE=cosine
CHROMA_HNSW_M=16
CHROMA_HNSW_EF_CONSTRUCTION=200

# Redis Configuration (optional)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_SSL=false

# Document Processing
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MAX_FILE_SIZE=52428800
ALLOWED_EXTENSIONS=[".pdf",".txt",".md",".docx",".html",".htm"]

# Embedding
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DIMENSION=768

# Retrieval
DEFAULT_TOP_K=5
MAX_TOP_K=20
SIMILARITY_THRESHOLD=0.7

# Generation
DEFAULT_TEMPERATURE=0.7
DEFAULT_MAX_TOKENS=2048
DEFAULT_TOP_P=0.9

# Cache
ENABLE_CACHE=true
CACHE_TTL=3600
CACHE_PREFIX=rag:

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090

# WebSocket
WS_HEARTBEAT_INTERVAL=30
WS_MAX_MESSAGE_SIZE=1048576

# File Storage
UPLOAD_DIR=./uploads
TEMP_DIR=./temp

# Evaluation
EVALUATION_ENABLED=true
EVALUATION_SAMPLE_SIZE=100