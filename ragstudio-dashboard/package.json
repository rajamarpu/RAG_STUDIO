{
  "name": "ragstudio-dashboard",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "backend": "node scripts/kill-ports.js 8000 && node scripts/run-backend.js",
    "dev:backend": "node scripts/run-backend.js",
    "dev:all": "concurrently -k -n frontend,backend -c yellow,green \"npm run dev\" \"npm run backend\"",
    "build": "npm --prefix frontend run build",
    "preview": "npm --prefix frontend run preview -- --host",
    "check": "npm --prefix frontend run build",
    "check:structure": "node scripts/check-structure.js",
    "format": "prettier --write ."
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^24.7.0",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "prettier": "^3.6.2"
  },
  "packageManager": "pnpm@10.4.1+sha512.c753b6c3ad7afa13af388fa6d808035a008e30ea9993f58c6663e2bc5ff21679aa834db094987129aa4d488b86df57f7b634981b2f827cdcacc698cc0cfb88af",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@tailwindcss/oxide"
    ],
    "overrides": {
      "tailwindcss>nanoid": "3.3.7"
    }
  }
}
